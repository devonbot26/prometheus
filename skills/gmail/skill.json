{
    "name": "gmail",
    "id": "gmail",
    "version": "1.0.0",
    "description": "Private Gmail Agent — scan inbox, compose/send emails with trust verification",
    "tools": {
        "gmail_scan": {
            "path": "bridge.js",
            "function": "gmail_scan",
            "description": "Scan emails based on a query (default: is:unread). Returns snippets and metadata.",
            "parameters": {
                "query": {
                    "type": "string",
                    "description": "Gmail search query (e.g. 'is:unread', 'from:boss')",
                    "required": false
                },
                "maxResults": {
                    "type": "number",
                    "description": "Max emails to list",
                    "required": false
                },
                "includeBody": {
                    "type": "boolean",
                    "description": "Whether to include full body in the list result",
                    "required": false
                }
            }
        },
        "gmail_read": {
            "path": "bridge.js",
            "function": "gmail_read",
            "description": "Retrieve the full text body and details of a specific email",
            "parameters": {
                "messageId": {
                    "type": "string",
                    "description": "The unique Gmail message ID",
                    "required": true
                }
            }
        },
        "gmail_compose": {
            "path": "bridge.js",
            "function": "gmail_compose",
            "description": "Draft or send a new email",
            "parameters": {
                "to": {
                    "type": "string",
                    "description": "Recipient email",
                    "required": true
                },
                "subject": {
                    "type": "string",
                    "description": "Email subject",
                    "required": true
                },
                "body": {
                    "type": "string",
                    "description": "Email body",
                    "required": true
                },
                "threadId": {
                    "type": "string",
                    "description": "Optional thread ID to link this email to a conversation",
                    "required": false
                }
            }
        },
        "gmail_reply": {
            "path": "bridge.js",
            "function": "gmail_reply",
            "description": "Reply to an existing thread by ID",
            "parameters": {
                "threadId": {
                    "type": "string",
                    "description": "The thread ID to reply to",
                    "required": true
                },
                "body": {
                    "type": "string",
                    "description": "The reply content",
                    "required": true
                }
            }
        },
        "gmail_batch_modify": {
            "path": "bridge.js",
            "function": "gmail_batch_modify",
            "description": "Batch modify messages (add/remove labels like UNREAD, INBOX)",
            "parameters": {
                "ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Array of message IDs",
                    "required": true
                },
                "addLabelIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Labels to add",
                    "required": false
                },
                "removeLabelIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Labels to remove",
                    "required": false
                }
            }
        },
        "gmail_get_auth_url": {
            "path": "bridge.js",
            "function": "gmail_get_auth_url",
            "description": "Generate the Google OAuth2 authorization URL for initial setup.",
            "parameters": {}
        },
        "gmail_set_auth_code": {
            "path": "bridge.js",
            "function": "gmail_set_auth_code",
            "description": "Exchange the Google authorization code for a persistent token.",
            "parameters": {
                "code": {
                    "type": "string",
                    "description": "The authorization code from Google",
                    "required": true
                }
            }
        }
    }
}