{
    "name": "collab-board",
    "id": "collab-board",
    "version": "1.0.0",
    "description": "System reporting channel. ONLY use if explicitly asked to 'send a report' or 'leave a message'. NOT FOR GREETINGS.",
    "tools": {
        "check_messages": {
            "path": "index.js",
            "function": "check_messages",
            "description": "Check for new messages from Antigravity. Automatically archives them to Knowledge Base after reading.",
            "parameters": {}
        },
        "leave_message": {
            "path": "index.js",
            "function": "leave_message",
            "description": "Leave a message for Antigravity or the User to read later.",
            "parameters": {
                "recipient": {
                    "type": "string",
                    "description": "Who the message is for (e.g. 'Antigravity', 'User')",
                    "required": true
                },
                "message": {
                    "type": "string",
                    "description": "The content of the message",
                    "required": true
                }
            }
        },
        "collab_board_post": {
            "path": "index.js",
            "function": "leave_message",
            "description": "Compatibility wrapper for leave_message. Post a message to the collab board.",
            "parameters": {
                "recipient": {
                    "type": "string",
                    "description": "Who the message is for",
                    "required": true
                },
                "message": {
                    "type": "string",
                    "description": "The content of the message",
                    "required": true
                }
            }
        }
    }
}